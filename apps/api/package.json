{
  "name": "@agentic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --env-file-if-exists=../../.env --import tsx scripts/sqlite-writer-supervisor.ts --watch",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=../../.env --import tsx scripts/sqlite-writer-supervisor.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preflight:factory-domain": "tsx --env-file=.env.local --env-file=../../.env scripts/factory-domain-preflight.ts",
    "verify:observability": "tsx --env-file=.env.local --env-file=../../.env scripts/verify-observability-canary.ts",
    "replay:factory-regression": "tsx src/services/agent-factory/regression-replay-cli.ts",
    "replay:factory-regressions": "tsx src/services/agent-factory/regression-replay-all-cli.ts",
    "export:factory-regressions": "tsx src/services/agent-factory/factory-regression-export-cli.ts",
    "probe:factory-sandbox": "tsx scripts/probe-factory-sandbox.ts",
    "setup:factory-production": "tsx scripts/setup-factory-production.ts",
    "verify:factory-production-images": "tsx scripts/verify-factory-production-images.ts",
    "watch:factory-production-images": "tsx scripts/verify-factory-production-images.ts --watch",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@agentic/agent-factory": "workspace:*",
    "@agentic/agent-kit": "workspace:*",
    "@agentic/agent-sdk": "workspace:*",
    "@agentic/agents": "workspace:*",
    "@agentic/contracts": "workspace:*",
    "@agentic/db": "workspace:*",
    "@agentic/llm-gateway": "workspace:*",
    "@agentic/mcp": "workspace:*",
    "@agentic/recruitment-capabilities": "workspace:*",
    "@agentic/runtime": "workspace:*",
    "@agentic/shared": "workspace:*",
    "@agentic/skills": "workspace:*",
    "@agentic/tools": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@tenants/agents-generation": "workspace:*",
    "@tenants/insightlab": "workspace:*",
    "@tenants/northwind": "workspace:*",
    "@tenants/raas": "workspace:*",
    "@tenants/robohire": "workspace:*",
    "@tenants/zhaopin": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "inngest": "4.4.0",
    "jose": "^5.10.0",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentic/mock-erp": "workspace:*",
    "@tenants/__system": "workspace:*",
    "@tenants/tenant-test1": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
