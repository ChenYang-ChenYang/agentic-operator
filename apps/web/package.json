{
  "name": "@agentic/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-with-env.mjs dev --port 3599",
    "build": "node scripts/next-with-env.mjs build",
    "start": "node scripts/next-with-env.mjs start --port 3599",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@agentic/contracts": "workspace:*",
    "@tanstack/react-query": "^5.100.11",
    "jose": "^6.2.3",
    "monaco-editor": "^0.55.1",
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "^10.4.0",
    "eslint-config-next": "16.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
