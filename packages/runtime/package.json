{
  "name": "@agentic/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agent-execution": "./src/agent-execution.ts",
    "./client": "./src/client.ts",
    "./execution-trace": "./src/execution-trace.ts",
    "./manifest": "./src/manifest.ts",
    "./register": "./src/register.ts"
  },
  "scripts": {
    "test": "vitest run && pnpm run test:node",
    "typecheck": "tsc --noEmit",
    "rotate-logs": "tsx src/log-rotate.ts",
    "gen:schema": "tsx src/generate-workflow-schema.ts",
    "gen:schema:check": "tsx src/generate-workflow-schema.ts --check",
    "clean": "rm -rf dist .turbo",
    "test:node": "node --test --import tsx src/action-model-overrides.test.ts src/agent-execution.test.ts src/event-envelope.test.ts src/execution-trace.test.ts src/generated-agent-prompt.test.ts src/lint.test.ts src/manifest-v2.test.ts src/manual-task-payload.test.ts src/register-config.test.ts src/step-engine-v2.test.ts src/usage-attribution-envelope.test.ts"
  },
  "dependencies": {
    "@agentic/agent-kit": "workspace:*",
    "@agentic/agent-sdk": "workspace:*",
    "@agentic/contracts": "workspace:*",
    "@agentic/db": "workspace:*",
    "@agentic/llm-gateway": "workspace:*",
    "@agentic/shared": "workspace:*",
    "@agentic/tools": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.2",
    "inngest": "4.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
