# --- Runtime mode ---
NODE_ENV=development
AUTH_MODE=production    # real session/token authentication; use dev only for an explicit local sandbox
# Required only when AUTH_MODE=dev; never inferred by the server.
# AGENTIC_DEV_TENANT=raas
# AGENTIC_DEV_USER_EMAIL=

# --- SQLite ---
DATABASE_URL=file:../../data/agentic.db
# Fsync'd NDJSON outbox used only when llm_calls cannot be written. Defaults
# beside DATABASE_URL and is replayed at startup/after later successful writes.
# AGENTIC_LLM_TELEMETRY_SPOOL_PATH=../../data/llm-telemetry-outbox.ndjson

# --- Inngest (ONE Inngest app per tenant) ---
# The platform __system app is served at /inngest (auto-discovered by the
# inngest-cli `-u .../inngest`); each tenant app `agentic-operator-<slug>` is
# served at /inngest/<slug> and PUT-self-synced to the Inngest server.
INNGEST_DEV=1
INNGEST_EVENT_KEY=local-dev-event-key
INNGEST_SIGNING_KEY=local-dev-signing-key
INNGEST_BASE_URL=http://localhost:8488
# Legacy/shared-bus event naming is declared by the selected tenant package's
# TenantEventAdapter. There is no process-wide bare-event switch.
# Origin the per-tenant apps register their serve URL at (this api's port).
INNGEST_SERVE_ORIGIN=http://localhost:3540
# Optional in development, REQUIRED per real tenant in production. This JSON
# stores env-variable NAMES only; credentials remain in the referenced vars.
# INNGEST_TENANT_CONFIG_REFS={"zhaopin":{"eventKeyEnv":"ZHAOPIN_INNGEST_EVENT_KEY","signingKeyEnv":"ZHAOPIN_INNGEST_SIGNING_KEY","serveOriginEnv":"ZHAOPIN_INNGEST_SERVE_ORIGIN"}}
# ZHAOPIN_INNGEST_EVENT_KEY=
# ZHAOPIN_INNGEST_SIGNING_KEY=
# ZHAOPIN_INNGEST_SERVE_ORIGIN=http://localhost:3540
# Reasoning-kernel output budget: sets the LARGEST per-call completion budget
# (final synthesis roles); other roles (critique/proposers/branches) scale by
# fixed ratios, and the shared ledger charge + low-budget thresholds follow.
# Default 1800, clamped 256..32000. Independent of FACTORY_KERNEL_MAX_CALLS
# (which caps the CALL COUNT per reasoning plan, default 10).
# FACTORY_KERNEL_MAX_TOKENS=1800
# Behavior-window knobs (defaults preserved; hardcode audit 2026-07-17):
# FACTORY_RUN_EVICT_MS=600000          # settled-run reconnect window in the run registry
# AGENTIC_LOG_ROTATE_DAYS=7            # log gzip-rotation cutoff (parity with AGENTIC_RETENTION_DAYS)
# AGENTIC_GOVERNANCE_WINDOW_DAYS=14    # governance sweep + fleet-reflux stats horizon (shared)
# FACTORY_ACTIVE_WORK_TTL_MS=3600000   # in-flight factory-work lease TTL
# FACTORY_REPORT_MAX_TOKENS=16000      # report-write completion budget (long reports truncate here)
# FACTORY_LLM_MAX_ATTEMPTS=5           # connection retries per model in the chain
# FACTORY_TOOL_RESULT_CAP=60000        # max chars of one tool result kept in brain context
# FACTORY_MAX_SUBAGENT_DEPTH=2         # nested sub-brain recursion depth
# Agent Factory generated code runs only on the external sandbox runner. This
# API-side JSON contains ENVIRONMENT VARIABLE NAMES, never values. Leave it
# unset when no runner exists: sandbox execution then returns ask_user instead
# of falling back to this API process or the primary Inngest app.
# FACTORY_SANDBOX_REMOTE_CONFIG_REFS={"runnerUrlEnv":"FACTORY_SB_RUNNER_URL","requestSigningKeyEnv":"FACTORY_SB_REQUEST_HMAC","resultSigningKeyEnv":"FACTORY_SB_RESULT_HMAC","receiptSigningKeyEnv":"FACTORY_SB_RECEIPT_HMAC","keyIdEnv":"FACTORY_SB_KEY_ID","runnerIdEnv":"FACTORY_SB_RUNNER_ID","allowedBuildIdsEnv":"FACTORY_SB_ALLOWED_BUILD_IDS","allowedImageDigestsEnv":"FACTORY_SB_ALLOWED_IMAGE_DIGESTS"}
# Host-run API only: localhost requires a separately host-run runner or a
# loopback tunnel. Docker Compose API must use http://sandbox-runner:3560.
# FACTORY_SB_RUNNER_URL=http://localhost:3560
# FACTORY_SB_REQUEST_HMAC=
# FACTORY_SB_RESULT_HMAC=
# FACTORY_SB_RECEIPT_HMAC=
# FACTORY_SB_KEY_ID=
# FACTORY_SB_RUNNER_ID=
# FACTORY_SB_ALLOWED_BUILD_IDS=
# FACTORY_SB_ALLOWED_IMAGE_DIGESTS=
# Docker/Kubernetes secrets may use absolute paths instead of direct values;
# never configure a value and its _FILE form at the same time. Under Compose,
# pair each container-side *_FILE with the matching existing *_HOST_FILE.
# FACTORY_SB_REQUEST_HMAC_FILE=/run/secrets/factory-sandbox-request-hmac
# FACTORY_SB_REQUEST_HMAC_HOST_FILE=/secure/factory-sandbox-request-hmac
# FACTORY_SB_RESULT_HMAC_FILE=/run/secrets/factory-sandbox-result-hmac
# FACTORY_SB_RESULT_HMAC_HOST_FILE=/secure/factory-sandbox-result-hmac
# FACTORY_SB_RECEIPT_HMAC_FILE=/run/secrets/factory-sandbox-receipt-hmac
# FACTORY_SB_RECEIPT_HMAC_HOST_FILE=/secure/factory-sandbox-receipt-hmac
# Broker event/signing keys and the workload/delete token are SANDBOX-ONLY and
# must not be added to the API env. See docs/agent-factory-external-sandbox.md.
# Workload-only one-shot CodeAct executor. Enable only after building/pulling
# the digest-pinned `codeact-candidate` target and exposing the daemon socket to
# sandbox-workload; candidate containers themselves receive no mounts/secrets.
FACTORY_EXEC_GENERATED=0
# FACTORY_CODEACT_CANDIDATE_IMAGE=sha256:<local-image-id>
# FACTORY_CODEACT_ALLOWED_IMAGE_DIGESTS=["sha256:<same-local-image-id>"]
# FACTORY_CODEACT_DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock
# FACTORY_CODEACT_DOCKER_SOCKET_GID=999
# The base compose topology forces this off. Production setup provisions a
# separate HMAC-authenticated launcher so the primary API never gets a socket.
PRODUCTION_CODEACT_EXECUTOR_ENABLED=0
# PRODUCTION_CODEACT_EXECUTOR_URL=http://codeact-executor:3570
# PRODUCTION_CODEACT_EXECUTOR_TOKEN_FILE=/run/secrets/codeact-executor/token
# PRODUCTION_CODEACT_EXECUTOR_TOKEN_HOST_FILE=/secure/codeact-executor/token
# PRODUCTION_CODEACT_EXECUTOR_HTTP_ALLOWED_HOSTS=codeact-executor
# PRODUCTION_CODEACT_EXPECTED_EXECUTOR_ID=production-codeact-<build-id>
# PRODUCTION_CODEACT_EXPECTED_BUILD_ID=<build-id>
# PRODUCTION_CODEACT_ALLOWED_CANDIDATE_REFS=["sha256:<candidate-image-id>"]
# PRODUCTION_CODEACT_ALLOWED_CANDIDATE_IMAGE_IDS=["sha256:<candidate-image-id>"]
# External sandbox lifecycle settings. Compose sends attempt lease/heartbeat
# and delete verification to workload, and job TTL to control; it does not
# expose these knobs to API. Heartbeat must be lower than lease; invalid values
# fail closed. Reapers never touch a live lease.
FACTORY_SANDBOX_ATTEMPT_LEASE_MS=180000
FACTORY_SANDBOX_ATTEMPT_HEARTBEAT_MS=30000
FACTORY_SANDBOX_JOB_TTL_MS=1080000
FACTORY_SANDBOX_REAPER_MS=60000
FACTORY_SANDBOX_DELETE_VERIFY_MS=8000
# Periodic reconciler (ms) re-syncs apps the Inngest server forgot (e.g. after a
# dev-server restart). 0 disables. Do NOT set INNGEST_SERVE_PATH — servePath is
# a per-app explicit option; a process-wide value collapses every app onto one path.
INNGEST_RECONCILE_MS=60000
# HITL reconciliation: resend an unacknowledged resolution every 30s, fail the
# owning task/run explicitly after 5m, and expire an untouched wait after 7d.
AGENTIC_HITL_RESUME_RETRY_MS=30000
AGENTIC_HITL_RESUME_TIMEOUT_MS=300000
AGENTIC_HITL_WAIT_TIMEOUT_MS=604800000

# --- Session/password auth ---
# REQUIRED outside NODE_ENV=test. Generate a unique value, for example with
# `openssl rand -hex 32`; never reuse the seed password.
AUTH_SESSION_SECRET=
# REQUIRED only when running `pnpm db:seed`. The seed creates exactly this one
# real superadmin and grants it admin access to every deployable tenant.
AGENTIC_BOOTSTRAP_ADMIN_EMAIL=
AGENTIC_BOOTSTRAP_ADMIN_NAME=
# Minimum 12 bytes; never logged and never defaults to a checked-in value.
AGENTIC_BOOTSTRAP_ADMIN_PASSWORD=
# Optional independent encryption secret/path for the persisted provider-key
# vault. When omitted, the vault derives its key from AUTH_SESSION_SECRET and
# is stored beside DATABASE_URL. REQUIRED in production before provider
# credentials can be stored or read through Settings (the vault refuses to
# operate on the derived fallback there).
# AGENTIC_KEY_VAULT_SECRET=
# AGENTIC_KEY_VAULT_PATH=../../data/provider-keys.json

# --- File storage roots ---
AGENTIC_LOGS_DIR=../../data/logs
AGENTIC_ARTIFACTS_DIR=../../data/artifacts
AGENTIC_MODELS_DIR=../../models
# Import commit uses atomic rename, so staging must share the models filesystem.
AGENTIC_IMPORTS_DIR=../../models/.imports

# --- RAAS-v1 resume intake (tenant=zhaopin only) ---
# Legacy RESUME_DOWNLOADED carries upload_id + bucket + object_key. AO copies
# the remote object into data/resumes/zhaopin/inbox before processResume runs.
# Choose ONE transport. Endpoints come only from env; payload URLs are ignored.
#
# Option A — RAAS authenticated raw-file endpoint. Available placeholders are
# {upload_id}, {bucket}, and {object_key} (each URL-encoded by AO).
# RAAS_RESUME_FETCH_URL_TEMPLATE=http://raas.internal/api/v1/resumes/uploads/{upload_id}/raw
# RAAS_RESUME_FETCH_TOKEN=
#
# Option B — direct S3-compatible MinIO (SigV4 GET, path-style).
# MINIO_ENDPOINT=192.168.1.106
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_REGION=us-east-1
#
# Both ingress and direct shared-Inngest delivery fail loudly when a remote
# resume is referenced but neither transport is complete.
RAAS_RESUME_FETCH_TIMEOUT_MS=30000
RAAS_RESUME_MAX_BYTES=10485760

# --- RAAS tenant client-system requirement sync (tenant=raas) ---
# `SCHEDULED_SYNC` calls this real endpoint. The service must return the
# versioned JSON receipt documented by requirement-sync.ts; missing/ambiguous
# responses fail the run and never emit REQUIREMENT_SYNCED.
# RAAS_CLIENT_REQUIREMENTS_API_URL=https://client.example.com/api/v1/requirements/changes
# RAAS_CLIENT_REQUIREMENTS_API_TOKEN=
# Required to enable the real Inngest producer. Standard 5/6-field cron or a
# named alias such as @hourly. Use `disabled` only for an intentional shutdown;
# an empty value is reported as UNCONFIGURED by /health and the dashboard.
RAAS_REQUIREMENTS_SYNC_CRON=
RAAS_REQUIREMENTS_SYNC_TIMEZONE=
# Shared timeout for RAAS external publication/submission/sync calls.
# RAAS_EXTERNAL_TIMEOUT_MS=30000

# --- LLM gateway defaults ---
# REQUIRED for normal runtime. Pick a real configured provider and one of the
# model ids it actually exposes. Non-test processes fail closed when either
# value selects the test-only mock adapter or the provider has no credentials.
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_MS=60000
# `false` keeps the control plane available during a transient upstream
# outage while `/health` reports the real provider as degraded. Set `true`
# only when deployment policy requires cold-start failure on connectivity.
# Missing credentials and mock providers are rejected in either mode.
AGENTIC_LLM_STARTUP_PROBE_STRICT=false
# Optional authoritative cents-per-million-token overrides for models absent
# from the curated catalog. Exact provider/model entries beat provider/*.
# Unknown models are never assigned a default price; tenants with a USD cap
# fail closed until their served model has a price.
# AGENTIC_LLM_MODEL_PRICING_JSON={"custom/my-model":{"inCents":120,"outCents":480}}
# Reject provider calls that cannot be assigned to a tenant/account.
LLM_REQUIRE_USAGE_ATTRIBUTION=true
# Database accounting always commits first; make portable-file delivery fatal only when required.
LLM_USAGE_EXPORT_REQUIRED=false
AGENTIC_USAGE_EXPORT_ROOT=
# AI Settings writes the complete non-secret workspace policy to JSON and
# mirrors it into a managed block in apps/api/.env.local. Leave paths blank to
# use data/llm-settings.json and apps/api/.env.local.
AGENTIC_LLM_SETTINGS_PATH=
AGENTIC_LLM_ENV_MIRROR_PATH=
# Dynamic NewAPI/OpenAI-compatible endpoints must be public HTTPS in production.
# Explicit exceptions are comma-separated host[:port] entries; use sparingly.
LLM_GATEWAY_ALLOWED_HOSTS=
LLM_ALLOW_INSECURE_GATEWAYS=false

# --- Agent Factory model routing by task difficulty (#7) ---
# Each tier is a comma-separated fallback chain (preferred first). The chain is validated against
# the gateway's LIVE /models catalog (ids it doesn't serve are dropped); everything ultimately
# falls back to FACTORY_AI_MODEL / LLM_DEFAULT_MODEL so the brain always runs. Leave a tier BLANK
# to DERIVE it from the live catalog by preference patterns (fast→luna/flash/haiku/mini, hard→sol/
# sonnet/deepseek-pro …), overridable via FACTORY_MODEL_<TIER>_PREFER. The router picks fast for
# reading/planning, default for design, hard for code/refine, and a dedicated `review` tier for the
# AI quality-judge / failure-diagnosis / post-run scoring (strongest model). Use the real ids your
# gateway serves — example (New API catalog, 质量优先·混合; gpt-5.6 tiers by price: luna $1/$6 →
# terra $2.50/$15 → sol $5/$30, `-pro` = extended reasoning at the same price):
# FACTORY_MODEL_FAST=openai/gpt-5.6-luna,google/gemini-3-flash-preview,anthropic/claude-haiku-4.5
# FACTORY_MODEL_DEFAULT=openai/gpt-5.6-terra,google/gemini-3.1-pro-preview-customtools,anthropic/claude-sonnet-4.6
# FACTORY_MODEL_HARD=openai/gpt-5.6-sol,anthropic/claude-sonnet-4.6,openai/gpt-5.6-sol-pro,anthropic/claude-opus-4.8
# FACTORY_MODEL_REVIEW=openai/gpt-5.6-sol-pro,anthropic/claude-opus-4.8,anthropic/claude-sonnet-4.6   # unset → uses HARD
FACTORY_MODEL_FAST=
FACTORY_MODEL_DEFAULT=
FACTORY_MODEL_HARD=
FACTORY_MODEL_REVIEW=

# #9 Brain language (i18n). zh (default — Chinese system prompt + roles + run-critic), en (English),
# or auto (follow the ontology/domain content's language). Lets the factory serve non-Chinese domains.
FACTORY_BRAIN_LANG=
# Whole-session runaway backstop. Defaults to 500000 outside tests; set 0 only
# when an external budget controller provides an equivalent hard stop.
FACTORY_BRAIN_MAX_SESSION_TOKENS=500000

# --- LLM provider API keys (leave blank for providers you don't use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=http://localhost:3599
OPENROUTER_APP_TITLE=Agentic Operator
GOOGLE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=

# Azure OpenAI (needs all three)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Custom OpenAI-compatible (e.g. self-hosted vLLM)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- AllmetaOntology Studio (live ontology source — Neo4j 唯一入口) ---
# New domain selections and every explicit binding are fetched over HTTP from
# AllmetaOntology (e.g. "Agents-generation"). Neo4j is Allmeta's implementation
# detail: the Agent Factory never connects to it directly and never falls back
# to models/<slug>/ for an explicit binding. Tenant uploads remain an explicit,
# separately identified source; only migration-era source=auto bindings retain
# local-manifest compatibility. Leave ALLMETA_BASE_URL blank and catalog/
# explicit reads fail closed. Domain catalog reads may be public, but
# rule-evaluation and instance-write endpoints require ONTOLOGY_API_TOKEN.
ALLMETA_BASE_URL=
ALLMETA_API_KEY=
ALLMETA_TIMEOUT_MS=8000

# --- GoHire / RoboHire integration profile inputs ---
# Live vendor host is GoHire (gohire.top); the API contract is RoboHire-compatible.
# GOHIRE_* is the canonical naming; ROBOHIRE_* kept as back-compat mirrors.
# Both values are intentionally blank. A human-confirmed profile chooses these
# environment-variable names; no endpoint or credential is inferred in code.
GOHIRE_API_KEY=
GOHIRE_API_BASE_URL=
ROBOHIRE_API_KEY=
ROBOHIRE_API_BASE_URL=

# --- Agent Builder retrieval tools (optional) ---
# Deep Search uses Tavily by default. Set one provider key globally, or bind a
# tenant-prefixed *_env name in the agent's search.web tool config.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# Comma-separated host[:port] allow-list for explicitly configured search
# endpoints. Any endpoint override also requires a tenant-scoped api_key_env.
SEARCH_API_ALLOWED_HOSTS=

# Neo4j Query API v2. NEO4J_QUERY_API_URL may be an origin or the complete
# https://host/db/<database>/query/v2 URL. ontology.query is generated,
# parameterized, read-only, and always filters every node by tenant_slug.
# (Distinct from the Allmeta Studio source above: the factory reads ontology
# through Allmeta; ontology.query is a runtime agent tool.)
NEO4J_QUERY_API_URL=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_TENANT_PROPERTY=tenant_slug
NEO4J_ID_PROPERTY=id
# Server-owned retrieval/property policy. Endpoint overrides also require
# tenant-scoped credentials; accessMode=Read is not an authorization boundary.
NEO4J_QUERY_API_ALLOWED_HOSTS=
NEO4J_ALLOWED_DATABASES=neo4j
NEO4J_ALLOWED_PROPERTIES=id,slug,name,title,description,summary,content,type,status,category,score,confidence,created_at,updated_at
NEO4J_MAX_RESPONSE_BYTES=524288

# --- zhaopin / RAAS-v1 write-before-emit persistence ---
# Auto-enabled per target: RAAS_POSTGRES_URL writes RAAS relational entities;
# ALLMETA_BASE_URL + ALLMETA_API_KEY writes ontology instances. When both are
# configured, PG commits first and Allmeta writes second. Any configured-target
# failure rejects the agent step, so its result event is not emitted.
# Set =0 only for isolated local UI work; set =1 to require at least one target.
ZHAOPIN_RAAS_PERSISTENCE_ENABLED=1
RAAS_POSTGRES_URL=
RAAS_POSTGRES_TIMEOUT_MS=8000
RAAS_POSTGRES_POOL_MAX=4
# Instance-write domain; live action-rule reads still use manifest bindings.
ALLMETA_DOMAIN=Agents-generation

# --- Agents-generation reviewed integration-profile environment refs ---
# These values are consumed only when a confirmed profile explicitly names
# them. Tool manifests store the variable NAMES, never the values. Missing or
# unreachable dependencies do not prevent OntoCode from drafting typed code,
# but runtime/sandbox/promotion remain blocked until a real probe succeeds.
#
# facts.query: server-owned READ statement catalog. JSON shape:
# {"operation.name":{"sql":"SELECT ...","params":["id"],"mode":"read","max_rows":100}}
AGENTS_GENERATION_RAAS_READ_STATEMENTS=
# Migration candidate in existing deployments:
# AGENTS_GENERATION_RAAS_STATEMENTS=
# entities.write / postgres.execute*: server-owned WRITE statement catalog.
# Raw SQL is never accepted from the model.
AGENTS_GENERATION_RAAS_WRITE_STATEMENTS=
# Migration candidate in existing deployments:
# AGENTS_GENERATION_RAAS_WRITES=
# A new profile must select exactly one reviewed env ref for each catalog.
# Never copy values automatically or use the write catalog for a read slot.
# Dedicated disposable-canary role/catalog; must not be the business role.
AGENTS_GENERATION_RAAS_WRITE_PROBE_URL=
AGENTS_GENERATION_RAAS_WRITE_PROBE_STATEMENTS=
#
# processResume object-store profile. Prefer a tenant-scoped read-only
# credential and exact bucket allow-list in the profile.
AGENTS_GENERATION_OBJECT_STORE_ENDPOINT=
AGENTS_GENERATION_OBJECT_STORE_ACCESS_KEY=
AGENTS_GENERATION_OBJECT_STORE_SECRET_KEY=
AGENTS_GENERATION_OBJECT_STORE_SESSION_TOKEN=
#
# GoHire uses GOHIRE_API_BASE_URL / GOHIRE_API_KEY above. Allmeta uses
# ALLMETA_BASE_URL / ALLMETA_API_KEY above. Their presence is not probe proof.

# --- #SCALE — pluggable backends (all inert until set; single-instance needs none of these) ---
# Shared blob backend: local fs stays the hot cache; when configured, every blob write REPLICATES
# out (content-addressed → idempotent) and a local read miss falls back to the shared store — so
# N api instances rehydrate each other's oversized payloads. Two built-ins (S3 wins if both set):
#
# S3-compatible (AWS S3 / Cloudflare R2 / MinIO — hand-rolled SigV4, no aws-sdk dependency):
# AGENTIC_BLOB_S3_BUCKET=
# AGENTIC_BLOB_S3_REGION=us-east-1          # R2 uses "auto"
# AGENTIC_BLOB_S3_ENDPOINT=                 # e.g. https://<acct>.r2.cloudflarestorage.com (path-style); blank = AWS
# AGENTIC_BLOB_S3_PREFIX=blobs/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Plain HTTP PUT/GET store behind a bearer token (Supabase storage gateway, nginx+dav, …):
# AGENTIC_BLOB_HTTP_BASE=
# AGENTIC_BLOB_HTTP_TOKEN=
#
# Cross-instance SSE fanout via Redis pub/sub (also: pnpm add ioredis -F @agentic/api).
# Missing package or dead Redis only degrades to single-instance — never crashes the api.
# REDIS_URL=redis://localhost:6379
#
# Verify a config flip took effect: curl /health → "blobBackend":"fs+s3|fs+http|fs", "fanout":"redis|local".
#
# Postgres/pgvector vector-memory backend (SQLite stays the KV system of record; pg carries the HNSW
# vector index). Configuration is a hard availability contract: boot, search, mirror, and delete
# fail explicitly when pgvector is unavailable; the API never substitutes local or empty results.
# MEMORY_EMBED_MODEL may be used only with an endpoint/model that returns exactly 256 dimensions;
# startup probes both the embedding endpoint and pgvector before reporting ready. Local dev container:
#   docker run -d --name agentic-pgvector --restart unless-stopped -p 5434:5432 \
#     -e POSTGRES_USER=agentic -e POSTGRES_PASSWORD=agentic_local_pw -e POSTGRES_DB=agentic \
#     -v agentic_pgvector_data:/var/lib/postgresql/data pgvector/pgvector:pg17
# AGENTIC_PGVECTOR_URL=postgres://agentic:agentic_local_pw@localhost:5434/agentic

# Comma-separated env-variable NAMES that workflow manifests may reference via
# *_env bindings without tenant namespacing (TENANT_<SLUG>_*). Use for
# platform-shared vendor creds (e.g. ROBOHIRE_API_KEY,ROBOHIRE_API_BASE_URL).
# Everything not listed must be tenant-namespaced — see
# apps/api/src/services/workflow-secret-policy.ts.
AGENTIC_WORKFLOW_SHARED_ENV_ALLOWLIST=

# Meta ERP mock service origin (apps/mock-erp, redesign 2026-08-19 G3), consumed
# by the metaerp.invoke tool via its base_url_env config (default binding).
METAERP_BASE_URL=http://localhost:3620

# Agent-execution live window (Studio eval-test client) — redesign 2026-08-19 §G2
AO_API_KEY=change-me
AO_EXECUTION_TENANT=power-scm
