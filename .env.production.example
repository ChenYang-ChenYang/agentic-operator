# Agentic Operator — production environment contract (P4-OPS-08).
#
# Every variable the runtime reads from `process.env` is listed here with
# a description and the safe production default. Variables flagged
# **REQUIRED** must be set for the API/web/inngest stack to boot
# correctly; leaving them at the placeholder will fail health checks.
#
# Validation:
#   * `docker compose --env-file .env.production config` will substitute
#     defaults and complain about any unset *required* var.
#   * `GET /health` returns 503 if the LLM gateway, SQLite, or inngest
#     subsystem reports `ok: false`.
#
# Secrets rotation: see `docs/RUNBOOK.md §3`.

# ─── Runtime mode ────────────────────────────────────────────────────────
# REQUIRED — must be "production" outside dev/test.
NODE_ENV=production

# Auth mode. "production" forces bearer-token authentication for every
# /v1/* route. "dev" unlocks the AGENTIC_DEV_TENANT fallback and is for
# local sandboxes only. CI sets AUTH_MODE=dev + a system tenant so unit
# tests can issue requests without minting a real api_tokens row.
AUTH_MODE=production

# ─── HTTP surface ────────────────────────────────────────────────────────
# Host interface and port used by the production Compose web service. The
# loopback default is safe for a same-host TLS reverse proxy; set 0.0.0.0 only
# when host/network firewall policy is intentional.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3599
# API is also loopback-only by default. A TLS reverse proxy/webhook ingress on
# the same host can reach it; choose 0.0.0.0 only with an intentional firewall.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3501

# Port the API process listens on inside the container. Compose maps this
# to the host via `API_PORT` (default 3501 → 3501). The local `pnpm dev`
# stack intentionally uses 3540 so it can coexist with the preview stack.
PORT=3501
HOST=0.0.0.0

# Where the web app is served from. Used by the API's CORS allow-list so
# browser sessions can call /v1/*. Must include scheme + host (+ port if
# non-standard).
WEB_ORIGIN=https://operator.example.com

# Public URL of the API. The web app uses this for SSR rewrites and the
# Next.js build embeds it into beforeFiles rewrites at build time.
AGENTIC_API_URL=https://api.operator.example.com

# Inbound rate limits (per minute, per authenticated tenant or per remote
# IP when unauthenticated). Read-heavy portal views use their own budget so
# normal dashboard fan-out cannot exhaust the stricter mutation budget.
# Set either value higher or disable via
# AGENTIC_RATE_LIMIT_DISABLED=1 if you front the API with a reverse
# proxy that already rate-limits.
AGENTIC_RATE_LIMIT_PER_MIN=100
AGENTIC_RATE_LIMIT_READS_PER_MIN=600
# AGENTIC_RATE_LIMIT_DISABLED=1

# Per-request body cap. Tenants that ship large code bundles (see
# `/v1/tenants/:slug/code`) may need this lifted to 5–10 MB. Bytes.
AGENTIC_BODY_LIMIT_BYTES=1048576

# SIGTERM drain window before `process.exit(1)` is forced. Bump this if
# your slowest in-flight handler legitimately takes > 30s.
AGENTIC_SHUTDOWN_TIMEOUT_MS=30000

# Optional override: pino log level (one of trace/debug/info/warn/error/
# fatal). Default `info` is right for production; bump to `warn` if log
# volume is a budget pain.
LOG_LEVEL=info

# Optional: deployed git SHA / image tag, surfaced on `/health.version`.
# CI usually sets this from the commit; leave blank for "dev".
# GIT_SHA=
AGENTIC_BUILD_ID=replace-with-immutable-build-id
# setup:factory-production records the non-root host owner of ./data and
# ./models. The API uses this identity so SQLite migrations and manifest
# promotion work without chown/0777. Set to the owning uid/gid when preparing
# this file manually; never use uid 0.
AGENTIC_RUNTIME_UID=1000
AGENTIC_RUNTIME_GID=1000

# ─── SQLite ──────────────────────────────────────────────────────────────
# Absolute path inside the container. The preview compose file mounts the
# persistent `agentic-data` named volume at `/app/data`, so the default places
# agentic.db on durable storage. A host bind may be configured explicitly.
DATABASE_URL=file:/app/data/agentic.db
# Keep this on the same persistent volume. If both SQLite and this fsync'd
# outbox fail, LLM results fail closed instead of losing supervision data.
AGENTIC_LLM_TELEMETRY_SPOOL_PATH=/app/data/llm-telemetry-outbox.ndjson

# Optional override for the better-sqlite3 native binding location. The
# resolver auto-walks node_modules — set this only when running outside
# the expected pnpm layout (e.g. a custom packaging).
# AGENTIC_SQLITE_BINDING=/app/node_modules/better-sqlite3/build/Release/better_sqlite3.node

# ─── File storage roots ──────────────────────────────────────────────────
# All paths are inside the container and must be persisted. Tenant-specific
# code lives under AGENTIC_TENANTS_DIR; AGENTIC_MODELS_DIR is a WRITABLE
# manifest store because import/promotion atomically publishes new versions.
AGENTIC_DATA_DIR=/app/data
# #AUDIT-FIX(P0-06) — factory 文件存储读 AGENTIC_DATA_ROOT；不设会写到未挂载目录、重启丢数据。
AGENTIC_DATA_ROOT=/app/data
AGENTIC_MODELS_DIR=/app/models
# Must be on the same filesystem as AGENTIC_MODELS_DIR for atomic publication.
AGENTIC_IMPORTS_DIR=/app/models/.imports
AGENTIC_LOGS_DIR=/app/data/logs
AGENTIC_ARTIFACTS_DIR=/app/data/artifacts
AGENTIC_TENANTS_DIR=/app/data/tenants

# Events + tasks retention (in days). The nightly runtime sweeper tombstones
# events/tasks older than this. Set 0 to disable.
AGENTIC_RETENTION_DAYS=30

# Runs retention (in days). Governed SEPARATELY and defaults to 0 = keep run
# monitoring records forever; operators prune them via the UI delete/cleanup
# actions (DELETE /v1/runs) + the recycle bin. Set a positive number to
# re-enable an automatic run sweep.
AGENTIC_RUN_RETENTION_DAYS=0

# ─── Inngest ─────────────────────────────────────────────────────────────
# REQUIRED for the platform __system app. For Cloud, copy both values from the
# Inngest environment dashboard. For self-host, generate and configure matching
# server-side keys (for example `openssl rand -hex 32`). Placeholder/dev/test
# values are rejected.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Production must use exactly one durable executor profile:
#
# Inngest Cloud (default): keep INNGEST_BASE_URL UNSET so the SDK uses its
# separate managed API + Event API origins. Set INNGEST_DEV=0 (or leave it
# unset) and expose the callback over public HTTPS.
#
# Production self-host: set INNGEST_BASE_URL to the hardened Inngest server
# origin (Redis/Postgres/persistent state, TLS as appropriate) and keep
# INNGEST_DEV=0. `inngest dev` is a local/CI broker and startup rejects it when
# NODE_ENV=production.
INNGEST_DEV=0
# INNGEST_BASE_URL=https://inngest.internal.example.com
INNGEST_SERVE_ORIGIN=https://api.operator.example.com
# Re-sync registered apps when a self-host/dev broker loses state; 0 disables.
INNGEST_RECONCILE_MS=60000
# Cloud health requires a recent signed sync acceptance newer than this bound.
INNGEST_CLOUD_SYNC_MAX_AGE_MS=180000

# RAAS-v1 compatibility: serve the zhaopin tenant at the legacy base callback
# and preserve the old app id. Its selected tenant adapter owns the six
# function ids and bare wire-event names.
INNGEST_MAIN_TENANT=zhaopin
INNGEST_MAIN_APP_ID=agentic-operator-main

# REQUIRED for every active business tenant. The JSON contains environment
# variable NAMES only; each referenced value is read at runtime and never
# returned by health/status endpoints. Add one entry + three secret/config
# variables per tenant. Missing, malformed, short, or placeholder credentials
# block that tenant's client/serve/sync and make readiness 503.
INNGEST_TENANT_CONFIG_REFS={"zhaopin":{"eventKeyEnv":"ZHAOPIN_INNGEST_EVENT_KEY","signingKeyEnv":"ZHAOPIN_INNGEST_SIGNING_KEY","serveOriginEnv":"ZHAOPIN_INNGEST_SERVE_ORIGIN"}}
ZHAOPIN_INNGEST_EVENT_KEY=
ZHAOPIN_INNGEST_SIGNING_KEY=
ZHAOPIN_INNGEST_SERVE_ORIGIN=https://api.operator.example.com

# REQUIRED before Agent Factory may produce promotable generated-function
# evidence. The Factory API talks to a separately deployed HTTPS runner; it
# never receives sandbox broker keys or delete tokens and never falls back to
# in-process execution. `http://sandbox-runner:3560` below is solely the
# single-host diagnostic profile and can never authorize promotion.
# This JSON contains environment variable NAMES only. Missing/weak HMAC,
# unallowlisted runner identity/build/image, or an unavailable runner returns
# ask_user and blocks sandbox/promotion.
FACTORY_SANDBOX_REMOTE_CONFIG_REFS={"runnerUrlEnv":"FACTORY_SB_RUNNER_URL","requestSigningKeyEnv":"FACTORY_SB_REQUEST_HMAC","resultSigningKeyEnv":"FACTORY_SB_RESULT_HMAC","receiptSigningKeyEnv":"FACTORY_SB_RECEIPT_HMAC","keyIdEnv":"FACTORY_SB_KEY_ID","runnerIdEnv":"FACTORY_SB_RUNNER_ID","allowedBuildIdsEnv":"FACTORY_SB_ALLOWED_BUILD_IDS","allowedImageDigestsEnv":"FACTORY_SB_ALLOWED_IMAGE_DIGESTS"}
FACTORY_SB_RUNNER_URL=http://sandbox-runner:3560
# Exact hostname allowlist for the internal plain-HTTP API -> runner channel.
# Wildcards and arbitrary external hosts are rejected.
FACTORY_SB_RUNNER_HTTP_ALLOWED_HOSTS=sandbox-runner
FACTORY_SB_REQUEST_HMAC=
FACTORY_SB_RESULT_HMAC=
FACTORY_SB_RECEIPT_HMAC=
FACTORY_SB_KEY_ID=
FACTORY_SB_RUNNER_ID=
# JSON array or comma-separated exact values; never wildcard these.
FACTORY_SB_ALLOWED_BUILD_IDS=
FACTORY_SB_ALLOWED_IMAGE_DIGESTS=
# To select a promotable external plane before running setup, set all of the
# following in the operator input `.env` (or the setup process environment).
# The URL must use HTTPS and the allowlists must each contain exactly one
# independently deployed, reviewed identity. setup refuses to copy local image
# IDs into these fields or to guess runner/key identities.
# FACTORY_PRODUCTION_IMAGE_ATTESTATION_TOPOLOGY=external_sandbox
# FACTORY_SB_RUNNER_URL=https://factory-sandbox.internal.example.com
# FACTORY_SB_RUNNER_HTTP_ALLOWED_HOSTS=factory-sandbox.internal.example.com
# FACTORY_SB_KEY_ID=factory-sandbox-key-v1
# FACTORY_SB_RUNNER_ID=factory-sandbox-runner-v1
# FACTORY_SB_ALLOWED_BUILD_IDS=["remote-runner-build-v1"]
# FACTORY_SB_ALLOWED_IMAGE_DIGESTS=["sha256:<64 lowercase hex>"]
# The runner reports these exact values in its signed execution receipt.
FACTORY_SB_RUNNER_BUILD_ID=
FACTORY_SB_RUNTIME_IMAGE_DIGEST=
# Production should mount HMAC from its secret manager. Use either direct or
# _FILE for a key, never both. request-hmac protects the durable anti-replay
# nonce ledger, result-hmac protects the durable job journal, and receipt-hmac
# signs independently verified execution evidence; all three must stay stable
# until a coordinated, versioned re-sign/migration operation is available.
# For Compose, *_FILE is the absolute path inside
# both API/control containers and *_HOST_FILE is the existing host-side source;
# Compose binds the latter to the former read-only and refuses a missing source.
# FACTORY_SB_REQUEST_HMAC_FILE=/run/secrets/factory-sandbox-request-hmac
# FACTORY_SB_REQUEST_HMAC_HOST_FILE=/secure/factory-sandbox-request-hmac
# FACTORY_SB_RESULT_HMAC_FILE=/run/secrets/factory-sandbox-result-hmac
# FACTORY_SB_RESULT_HMAC_HOST_FILE=/secure/factory-sandbox-result-hmac
# FACTORY_SB_RECEIPT_HMAC_FILE=/run/secrets/factory-sandbox-receipt-hmac
# FACTORY_SB_RECEIPT_HMAC_HOST_FILE=/secure/factory-sandbox-receipt-hmac
# Dedicated API↔trusted-workload model proxy token. It is not a provider key
# and is never mounted into one-shot candidate containers.
# FACTORY_SB_MODEL_PROXY_TOKEN_FILE=/run/secrets/factory-sandbox/model-proxy-token
# FACTORY_SB_MODEL_PROXY_TOKEN_HOST_FILE=/secure/factory-sandbox-model-proxy-token
# Durable cancel fences are shared only by sandbox control/workload. This MAC
# key must remain stable while any persisted fence exists; generic secret
# rotation intentionally preserves it.
# SANDBOX_CANCEL_FENCE_HMAC_FILE=/run/secrets/factory-sandbox/cancel-fence-hmac
# SANDBOX_CANCEL_FENCE_HMAC_HOST_FILE=/secure/factory-sandbox/cancel-fence-hmac
SANDBOX_CANCEL_FENCE_MAX_ENTRIES=10000

# Stable gateway tombstone integrity key. setup:factory-production creates the
# host file once and never rotates it through generic secret rotation, because
# old signed tombstones must remain verifiable across gateway restarts.
# SANDBOX_GATEWAY_TOMBSTONE_HMAC_FILE=/run/secrets/factory-sandbox/gateway-tombstone-hmac
# SANDBOX_GATEWAY_TOMBSTONE_HMAC_HOST_FILE=/secure/agentic/sandbox/gateway-tombstone-hmac
SANDBOX_GATEWAY_TOMBSTONE_MAX_ENTRIES=10000
SANDBOX_MODEL_PROXY_ORIGIN=http://api:3501
SANDBOX_MODEL_PROXY_HTTP_ALLOWED_HOSTS=api
# Hard conservative input+output token envelope for one remote verification.
FACTORY_SANDBOX_BUDGET_TOKENS=500000
# SANDBOX_MODEL_PROXY_TOKEN_FILE=/run/secrets/factory-sandbox/model-proxy-token
# Compose image selection is deployment metadata, not an API credential. Use
# an immutable digest in production. Local setup writes exact `sha256:<image
# id>` values, never the diagnostic tags it leaves for operators. The
# sandbox-only broker and
# workload/delete secrets go in a separate secure compose/orchestrator env,
# never in this API env_file.
# FACTORY_SANDBOX_CONTROL_IMAGE=registry.example/agentic/sandbox-control@sha256:<digest>
# FACTORY_SANDBOX_WORKLOAD_IMAGE=registry.example/agentic/sandbox-workload@sha256:<digest>
# Host readiness writes a short-lived Ed25519-signed Docker inspection here.
# With external_sandbox it attests only the primary host's API, web,
# codeact-executor and candidate image. Remote runner/workload/gateway identity
# comes from signed health/execution receipts and the exact allowlists above.
# single_host_compose remains available for diagnostics but is never promotable.
FACTORY_PRODUCTION_IMAGE_ATTESTATION_FILE=/app/data/factory-production-image-attestation.json
FACTORY_PRODUCTION_IMAGE_ATTESTATION_TOPOLOGY=single_host_compose
FACTORY_PRODUCTION_IMAGE_ATTESTATION_PUBLIC_KEY_FILE=/run/secrets/factory-production-image-attestation-public.pem
# Host source for the public half only. setup creates it beside a host-only
# private key; Compose never mounts or names the private key.
# FACTORY_PRODUCTION_IMAGE_ATTESTATION_PUBLIC_KEY_HOST_FILE=/secure/agentic/production-image-attestation/public.pem
FACTORY_PRODUCTION_IMAGE_ATTESTATION_TTL_MS=300000
# Generated CodeAct stays disabled unless all four values are explicit. The
# candidate is the separate `codeact-candidate` Dockerfile target; mutable tags
# are rejected before Docker is contacted.
FACTORY_EXEC_GENERATED=0
# FACTORY_CODEACT_CANDIDATE_IMAGE=registry.example/agentic/codeact-candidate@sha256:<digest>
# FACTORY_CODEACT_ALLOWED_IMAGE_DIGESTS=["registry.example/agentic/codeact-candidate@sha256:<same-digest>"]
# FACTORY_CODEACT_DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock
# FACTORY_CODEACT_DOCKER_SOCKET_GID=999
# Promoted CodeAct uses a distinct long-lived launcher service. The API receives
# only the internal URL and this dedicated HMAC secret; the launcher alone gets
# the Docker socket. setup:factory-production creates the secret and exact
# single-host values automatically.
PRODUCTION_CODEACT_EXECUTOR_ENABLED=0
# PRODUCTION_CODEACT_EXECUTOR_IMAGE=registry.example/agentic/production-codeact-executor@sha256:<digest>
# PRODUCTION_CODEACT_EXECUTOR_URL=http://codeact-executor:3570
# PRODUCTION_CODEACT_EXECUTOR_TOKEN_FILE=/run/secrets/codeact-executor/token
# PRODUCTION_CODEACT_EXECUTOR_TOKEN_HOST_FILE=/secure/codeact-executor/token
# PRODUCTION_CODEACT_EXECUTOR_HTTP_ALLOWED_HOSTS=codeact-executor
# The API verifies all four non-secret identities on every signed terminal.
# PRODUCTION_CODEACT_EXPECTED_EXECUTOR_ID=production-codeact-<reviewed-build-id>
# PRODUCTION_CODEACT_EXPECTED_BUILD_ID=<reviewed-build-id>
# PRODUCTION_CODEACT_ALLOWED_CANDIDATE_REFS=["registry.example/agentic/codeact-candidate@sha256:<digest>"]
# PRODUCTION_CODEACT_ALLOWED_CANDIDATE_IMAGE_IDS=["sha256:<local-docker-image-id>"]
# PRODUCTION_CODEACT_EXECUTOR_MAX_ACTIVE=8
# Deep readiness probes Docker + the reviewed candidate image. The reaper only
# targets io.agentic.execution-plane=production-codeact candidates; a cleanup
# failure keeps /health at 503 and therefore keeps the API dependency closed.
# PRODUCTION_CODEACT_REAPER_INTERVAL_MS=30000
# PRODUCTION_CODEACT_ORPHAN_GRACE_MS=120000
# SIGTERM rejects new work, aborts active candidates, then proves removal. The
# Compose stop grace must remain longer than this bounded drain timeout.
# PRODUCTION_CODEACT_DRAIN_TIMEOUT_MS=15000
# FACTORY_SANDBOX_CONTROL_PULL_POLICY=never
# FACTORY_SANDBOX_WORKLOAD_PULL_POLICY=never
# Do not hand-copy these four image/build/allowlist values from a CI log. The
# signed release manifest must pass `pnpm verify:factory-sandbox-release --
# <manifest> <output.env> <bundle-dir>` first; use its generated env fragment.
# External sandbox lifecycle settings. Compose routes attempt lease/heartbeat,
# delete verification and the durable-attempt reaper to workload; job TTL and
# the signed-job reaper are mapped to control. API overrides all of them empty.
# Heartbeat must be lower than lease. Startup/promotion remains closed while
# any attempt is not cleanup_verified.
# Workload-only Inngest SDK mode. Production stays signed/durable by default;
# set 1 only for the isolated local profile that runs the bundled `inngest dev`.
# Compose explicitly clears this value from the API process.
SANDBOX_INNGEST_DEV_MODE=0
FACTORY_SANDBOX_ATTEMPT_LEASE_MS=180000
FACTORY_SANDBOX_ATTEMPT_HEARTBEAT_MS=30000
FACTORY_SANDBOX_JOB_TTL_MS=1080000
FACTORY_SANDBOX_REAPER_MS=60000
FACTORY_SANDBOX_DELETE_VERIFY_MS=8000

# Durable human-wait recovery. A resolution remains `resolving` until the
# owning Inngest wait acknowledges it; retries reuse one stable resume marker.
AGENTIC_HITL_RESUME_RETRY_MS=30000
AGENTIC_HITL_RESUME_TIMEOUT_MS=300000
AGENTIC_HITL_WAIT_TIMEOUT_MS=604800000

# Orphaned run recovery. A run with no terminal update past this age is failed;
# periodic recovery can be disabled explicitly with reconcile=0.
AGENTIC_RUN_TIMEOUT_MS=1800000
AGENTIC_RUN_RECONCILE_MS=60000

# --- Live ontology (rule-check) — reach the host Allmeta Studio from the
#     container via host.docker.internal (compose maps it via extra_hosts). ---
ALLMETA_BASE_URL=
# Required for the Reasoning Agent rule API and ontology instance writes.
ALLMETA_API_KEY=
ALLMETA_TIMEOUT_MS=8000

# --- GoHire / RoboHire (RAAS resume parse / match / invite). ---
# GOHIRE_* is canonical for generated profiles; ROBOHIRE_* remains a
# compatibility mirror for reviewed legacy manifests.
GOHIRE_API_KEY=
GOHIRE_API_BASE_URL=
ROBOHIRE_API_KEY=
ROBOHIRE_API_BASE_URL=

# --- zhaopin / legacy RAAS-v1 runtime dependencies ---
# The six recruitment functions are fail-closed. Rule context always requires
# the authoritative partner Postgres; write-before-emit requires at least one
# configured persistence target when enabled.
ZHAOPIN_RAAS_PERSISTENCE_ENABLED=1
RAAS_POSTGRES_URL=
RAAS_POSTGRES_TIMEOUT_MS=8000
RAAS_POSTGRES_POOL_MAX=4
ALLMETA_DOMAIN=Agents-generation

# --- Agents-generation reviewed integration-profile environment refs ---
# Store only these variable names in manifests/profiles, never literal values.
# An env reference being populated is configuration evidence, not connectivity
# proof; external execution and promotion still require a live signed probe.
AGENTS_GENERATION_RAAS_READ_STATEMENTS=
# Existing installations may use AGENTS_GENERATION_RAAS_STATEMENTS.
AGENTS_GENERATION_RAAS_WRITE_STATEMENTS=
# Existing installations may use AGENTS_GENERATION_RAAS_WRITES.
# Treat both as migration candidates: select exactly one env ref per profile
# slot after operator confirmation; never copy values or mix read/write catalogs.
AGENTS_GENERATION_RAAS_WRITE_PROBE_URL=
AGENTS_GENERATION_RAAS_WRITE_PROBE_STATEMENTS=
AGENTS_GENERATION_OBJECT_STORE_ENDPOINT=
AGENTS_GENERATION_OBJECT_STORE_ACCESS_KEY=
AGENTS_GENERATION_OBJECT_STORE_SECRET_KEY=
AGENTS_GENERATION_OBJECT_STORE_SESSION_TOKEN=

# Resume transport: configure either the trusted HTTP template or the complete
# MinIO credential set. Event payload URLs are intentionally ignored.
# RAAS_RESUME_FETCH_URL_TEMPLATE=https://raas.internal/api/v1/resumes/uploads/{upload_id}/raw
# RAAS_RESUME_FETCH_TOKEN=
# MINIO_ENDPOINT=minio.internal
# MINIO_PORT=9000
# MINIO_USE_SSL=true
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
RAAS_RESUME_FETCH_TIMEOUT_MS=30000
RAAS_RESUME_MAX_BYTES=10485760

# RAAS client requirement ingestion. Required before publishing SCHEDULED_SYNC
# to the `raas` tenant. The endpoint must acknowledge a version-1 receipt with
# ok:true, request_id, source_system, and a strictly identified requirements[]
# batch; all failures/ambiguous 2xx responses stop before REQUIREMENT_SYNCED.
RAAS_CLIENT_REQUIREMENTS_API_URL=
RAAS_CLIENT_REQUIREMENTS_API_TOKEN=
RAAS_REQUIREMENTS_SYNC_CRON=
RAAS_REQUIREMENTS_SYNC_TIMEZONE=
RAAS_EXTERNAL_TIMEOUT_MS=30000

# The repository docker-compose stack intentionally uses `inngest dev` and is
# a local persistent PREVIEW, not this production contract.

# Cron schedule for the retention tombstone sweep. This is the sole runtime
# reader of AGENTIC_SYSTEM_CRON. Format: standard 5- or 6-field cron.
# AGENTIC_SYSTEM_CRON_DISABLED=1 removes that Inngest function entirely.
AGENTIC_SYSTEM_CRON=0 3 * * *
# AGENTIC_SYSTEM_CRON_DISABLED=1

# Optional Agent Factory governance supervision. When enabled, startup waits
# for a successful first real DB/store sweep; subsequent passes run at this
# interval. Leave 0 to disable.
AGENTIC_GOVERNANCE=0
AGENTIC_GOVERNANCE_TICK_MS=21600000

# Autonomous Factory whole-session spend fuse. Exact provider usage is
# persisted after every model call. Set 0 only when an external controller
# enforces an equivalent hard cap.
FACTORY_BRAIN_MAX_SESSION_TOKENS=500000

# ─── Session/password auth ───────────────────────────────────────────────
# The session secret must be ≥ 32 bytes. Rotate it through a coordinated
# session migration; changing it immediately invalidates existing cookies.
AUTH_SESSION_SECRET=

# One-time `pnpm db:seed` bootstrap identity. The seed provisions exactly this
# real superadmin; there are no built-in users or credentials. Supply these to
# the seed command through your secret manager, then remove the password from
# the long-lived runtime environment.
AGENTIC_BOOTSTRAP_ADMIN_EMAIL=
AGENTIC_BOOTSTRAP_ADMIN_NAME=
AGENTIC_BOOTSTRAP_ADMIN_PASSWORD=

# ─── Provider-key vault ──────────────────────────────────────────────────
# Encryption secret for provider keys saved through the operator. REQUIRED in
# production before provider credentials can be stored or read through
# Settings; dev derives a fallback. The vault path defaults beside
# DATABASE_URL, which is already on the persistent volume.
AGENTIC_KEY_VAULT_SECRET=
AGENTIC_KEY_VAULT_PATH=/app/data/provider-keys.json

# ─── LLM gateway defaults ────────────────────────────────────────────────
# REQUIRED. Production startup rejects the test-only mock adapter, a mock-like
# model id, or a real provider without the required credentials.
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_MS=60000
# Optional cold-start hard gate. With `false`, Settings, audit and repair
# surfaces remain online while `/health` reports the real provider outage.
AGENTIC_LLM_STARTUP_PROBE_STRICT=false
# Required for any enabled USD budget whose served model is not priced in the
# curated provider catalog. Values are cents per one million tokens.
# AGENTIC_LLM_MODEL_PRICING_JSON={"custom/my-model":{"inCents":120,"outCents":480}}

# Reject provider calls that cannot be assigned to a tenant/account.
LLM_REQUIRE_USAGE_ATTRIBUTION=true
# Database accounting always commits first; set true to make portable-file
# usage-export delivery fatal instead of best-effort.
LLM_USAGE_EXPORT_REQUIRED=false
# Optional root for portable per-tenant usage export files; blank = beside data.
AGENTIC_USAGE_EXPORT_ROOT=
# AI Settings writes the complete non-secret workspace policy to JSON and
# mirrors it into a managed block in apps/api/.env.local. Leave paths blank to
# use data/llm-settings.json and apps/api/.env.local.
AGENTIC_LLM_SETTINGS_PATH=
AGENTIC_LLM_ENV_MIRROR_PATH=
# Dynamic NewAPI/OpenAI-compatible endpoints must be public HTTPS in production.
# Explicit exceptions are comma-separated host[:port] entries; use sparingly.
LLM_GATEWAY_ALLOWED_HOSTS=
LLM_ALLOW_INSECURE_GATEWAYS=false

# Optional pgvector semantic-memory index. Once configured it is a hard
# dependency: startup and live index/search operations fail closed on outage.
# SQLite remains the durable KV record; the vector embedder must return 256 dims.
# AGENTIC_PGVECTOR_URL=postgres://agentic:change-me@pgvector:5432/agentic
# MEMORY_EMBED_MODEL=
# MEMORY_EMBED_BASE_URL=
# MEMORY_EMBED_API_KEY=
# MEMORY_EMBED_DIMENSIONS=256
# MEMORY_EMBED_TIMEOUT_MS=8000

# ─── LLM provider API keys (set only the providers you use) ──────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=https://operator.example.com
OPENROUTER_APP_TITLE=Agentic Operator
GOOGLE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=

# Azure OpenAI (all three required when used)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Custom OpenAI-compatible endpoint (self-hosted vLLM, etc.)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ─── Agent Builder retrieval tools (optional) ───────────────────────────
# Configure the provider selected by search.web. Per-tenant deployments may
# instead bind a tenant-prefixed api_key_env in tool_use[].config.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
SEARCH_API_ALLOWED_HOSTS=

# Neo4j Query API v2 used by ontology.query. Prefer a read-only Neo4j account;
# the SDK requests accessMode=Read and generates only tenant-scoped queries.
# Use a truly read-only principal: accessMode is routing, not authorization.
NEO4J_QUERY_API_URL=https://neo4j.example.com
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_TENANT_PROPERTY=tenant_slug
NEO4J_ID_PROPERTY=id
NEO4J_QUERY_API_ALLOWED_HOSTS=
NEO4J_ALLOWED_DATABASES=neo4j
NEO4J_ALLOWED_PROPERTIES=id,slug,name,title,description,summary,content,type,status,category,score,confidence,created_at,updated_at
NEO4J_MAX_RESPONSE_BYTES=524288

# ─── Observability ───────────────────────────────────────────────────────
# `/metrics` is unauthenticated by design. Restrict access via a reverse
# proxy ACL or by binding the API to a private network. Documented in
# `docs/RUNBOOK.md §6`.
