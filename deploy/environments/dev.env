# deploy/environments/dev.env — LOCAL DEVELOPMENT profile (design §2, req #7).
#
# Topology: everything runs on the HOST (no containers) via `pnpm dev`:
#   web :3599 · api :3540 · inngest dev :8488 · mock-erp :3620 (pnpm --filter
#   @agentic/mock-erp dev). scripts/deploy-env.mjs treats an empty
#   DEPLOY_COMPOSE_FILES as "host stack" and prints the pnpm commands instead
#   of invoking docker compose.
#
# Values here are non-secret defaults + placeholders. Real credentials live in
# the untracked root `.env` / `apps/api/.env.local` (see .env.example).

DEPLOY_ENV_NAME=dev
# Host stack — no compose files. (deploy-env.mjs prints `pnpm dev` guidance.)
DEPLOY_COMPOSE_FILES=
DEPLOY_COMPOSE_PROFILES=
DEPLOY_ENV_FILE=.env

# --- Ports (host processes) ---
API_PORT=3540
WEB_PORT=3599
INNGEST_PORT=8488
MOCK_ERP_PORT=3620

# --- Health endpoints verified by scripts/deploy-env.mjs ---
DEPLOY_HEALTH_URLS=http://localhost:3540/health,http://localhost:3620/health

# --- Runtime mode ---
NODE_ENV=development
AUTH_MODE=production
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8488
INNGEST_SERVE_ORIGIN=http://localhost:3540

# --- Meta ERP (apps/mock-erp, design §G3) ---
METAERP_BASE_URL=http://localhost:3620

# --- Agent-execution live window (design §G2) + A2A loopback ---
# AO_API_KEY authenticates Studio's /api/agent-execution/live/* client;
# AO_EXECUTION_TENANT names the single tenant that window serves.
AO_API_KEY=
AO_EXECUTION_TENANT=power-scm
# comms.sendToAgent loopback ingest (tools → this api's POST /v1/events).
AGENTIC_SELF_BASE_URL=http://localhost:3540
AGENTIC_SELF_API_TOKEN=

# --- LLM defaults (dev may use any configured provider; see .env.example) ---
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_MS=60000
LLM_REQUIRE_USAGE_ATTRIBUTION=true

# --- Browser computer-use tools (design §G5) ---
# Leave unset to auto-resolve (Chrome channel → /Applications → /usr/bin).
BROWSER_TOOLS_EXECUTABLE=
