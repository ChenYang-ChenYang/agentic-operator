# deploy/environments/production.env — PRODUCTION profile (design §2, req #7).
#
# Topology: full containerized stack — base topology + production overlay:
#
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.production.yml up -d
#
# The production overlay replaces both `inngest dev` brokers with durable
# `inngest start` servers backed by PostgreSQL + Redis, keeps the primary
# broker off host ports, and requires immutable image digests (AGENTIC_API_IMAGE
# etc. — supplied via .env.production, not here). scripts/deploy-env.mjs runs
# `corepack pnpm build` first when invoked with --build, and defaults to a
# dry-run `docker compose config` check unless DEPLOY_DRY_RUN=0.

DEPLOY_ENV_NAME=production
DEPLOY_COMPOSE_FILES=docker-compose.yml,docker-compose.production.yml
DEPLOY_COMPOSE_PROFILES=
DEPLOY_ENV_FILE=.env.production

# --- Ports (loopback-bound by the production overlay; front with a proxy) ---
API_PORT=3501
API_BIND_ADDRESS=127.0.0.1
WEB_PORT=3599
WEB_BIND_ADDRESS=127.0.0.1

# --- Health endpoints verified by scripts/deploy-env.mjs ---
DEPLOY_HEALTH_URLS=http://127.0.0.1:3501/health

# --- Runtime mode ---
NODE_ENV=production
AUTH_MODE=production
# INNGEST_DEV must be UNSET in production (the api rejects the mixed mode).

# --- Meta ERP ---
# Production points at the real Meta ERP OpenAPI origin (or a dedicated
# mock-erp deployment for launch demos). NEVER a developer laptop address.
METAERP_BASE_URL=

# --- Agent-execution live window ---
# REQUIRED before Studio's eval-test window may hit this deployment.
AO_API_KEY=
AO_EXECUTION_TENANT=power-scm
# comms.sendToAgent loopback ingest — the api's own public origin + a
# tenant-scoped API token minted in Settings → Tokens.
AGENTIC_SELF_BASE_URL=http://127.0.0.1:3501
AGENTIC_SELF_API_TOKEN=

# --- LLM defaults (REQUIRED: a real provider + model it serves) ---
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_MS=60000
LLM_REQUIRE_USAGE_ATTRIBUTION=true

# --- Browser computer-use tools ---
# Container images must bake a chromium and pin it explicitly here.
BROWSER_TOOLS_EXECUTABLE=/usr/bin/chromium
