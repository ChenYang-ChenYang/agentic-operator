# deploy/environments/sandbox.env — SANDBOX / EVALUATION profile (design §2).
#
# Topology: the HOST dev api (pnpm dev) plus the containerized factory-sandbox
# plane published to loopback — the promotion-path stage where compiled
# manifests run under the workflow-test-runner with GATED tools (writes are
# recorded, not fired) before a production import.
#
#   docker compose --env-file .env.production --env-file ~/.agentic/factory-sandbox.env \
#     --profile factory-sandbox -f docker-compose.yml -f docker-compose.dev-sandbox.yml \
#     up -d sandbox-inngest sandbox-workload sandbox-runner
#
# scripts/deploy-env.mjs assembles exactly that command from the variables
# below. docker-compose.dev-sandbox.yml must NEVER be used in production.

DEPLOY_ENV_NAME=sandbox
DEPLOY_COMPOSE_FILES=docker-compose.yml,docker-compose.dev-sandbox.yml
DEPLOY_COMPOSE_PROFILES=factory-sandbox
DEPLOY_ENV_FILE=.env.production
# Only the sandbox plane comes up in containers; the api/web stay host-run.
DEPLOY_COMPOSE_SERVICES=sandbox-inngest,sandbox-workload,sandbox-runner

# --- Ports ---
API_PORT=3540
WEB_PORT=3599
INNGEST_PORT=8488
MOCK_ERP_PORT=3620
# Control runner published to loopback for the host api.
FACTORY_SB_RUNNER_PORT=3560

# --- Health endpoints verified by scripts/deploy-env.mjs ---
DEPLOY_HEALTH_URLS=http://localhost:3540/health,http://localhost:3620/health

# --- Runtime mode ---
NODE_ENV=development
AUTH_MODE=production
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8488
INNGEST_SERVE_ORIGIN=http://localhost:3540
FACTORY_SB_RUNNER_URL=http://127.0.0.1:3560

# --- Meta ERP (sandbox evals still target the local mock) ---
METAERP_BASE_URL=http://localhost:3620

# --- Agent-execution live window (Studio eval-test hits this window) ---
AO_API_KEY=
AO_EXECUTION_TENANT=power-scm
AGENTIC_SELF_BASE_URL=http://localhost:3540
AGENTIC_SELF_API_TOKEN=

# --- LLM defaults — pin cheap/fast models for eval sweeps ---
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_MS=60000
LLM_REQUIRE_USAGE_ATTRIBUTION=true

# --- Browser computer-use tools ---
BROWSER_TOOLS_EXECUTABLE=
